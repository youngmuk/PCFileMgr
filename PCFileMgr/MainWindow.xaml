<Window x:Class="PCFileMgr.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PCFileMgr" Style="{StaticResource {x:Type Window}}" Title="PCFileMgr · 디스크 공간 분석" Width="1480" Height="940" MinWidth="1160" MinHeight="800" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="74"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Background="{StaticResource Panel}" Padding="24,0">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="Assets/AppIcon.png" Width="40" Height="40" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/><StackPanel><TextBlock Text="PCFileMgr" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="DISK SPACE EXPLORER" FontSize="9" Foreground="{StaticResource Muted}"/></StackPanel></StackPanel>
        <Grid Grid.Column="1" VerticalAlignment="Center" Margin="12,0,18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="PathBox" AutomationProperties.Name="분석할 폴더 경로" ToolTip="드라이브 또는 폴더 경로 · Enter로 분석" KeyDown="PathBox_KeyDown"/><Button Grid.Column="1" x:Name="BrowseButton" Content="폴더 선택" Click="Browse_Click" Margin="8,0,0,0"/></Grid>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="ScanButton" Content="분석 / 변경 확인" Style="{StaticResource PrimaryButton}" Click="Scan_Click" MinWidth="100"/><Button x:Name="ForceScanButton" Content="전체 재분석" Click="ForceScan_Click" ToolTip="캐시를 무시하고 전체 분석 (Shift+F5)" Margin="8,0,0,0"/><Button x:Name="CancelButton" Content="중지" Click="Cancel_Click" IsEnabled="False" Margin="8,0,0,0"/></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="224*" MinWidth="180"/><ColumnDefinition Width="6"/><ColumnDefinition Width="934*" MinWidth="500"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
      <Border Background="{StaticResource Panel}" Padding="16,22,12,14">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="로컬 드라이브" Foreground="{StaticResource Muted}" FontSize="11" Margin="8,0,0,12"/>
          <StackPanel x:Name="DrivePanel" Grid.Row="1"/>
          <DockPanel Grid.Row="2" Margin="8,24,0,10"><Button DockPanel.Dock="Right" Content="↻" Padding="7,2" ToolTip="드라이브 목록 새로 고침" Click="RefreshDrives_Click"/><TextBlock Text="폴더 탐색" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/></DockPanel>
          <TreeView x:Name="FolderTree" Grid.Row="3" SelectedItemChanged="FolderTree_SelectedItemChanged" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"/>
          <TextBlock Grid.Row="4" Style="{StaticResource MutedText}" FontSize="11" Text="로컬에서만 분석합니다.&#x0a;파일 내용은 읽거나 전송하지 않습니다." Margin="8,14,0,0"/>
        </Grid>
      </Border>
      <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False" Focusable="True" KeyboardIncrement="16" Cursor="SizeWE" AutomationProperties.Name="왼쪽 패널 너비 조절" ToolTip="좌우로 드래그하여 패널 너비 조절 · 선택 후 ← / →">
        <GridSplitter.Template><ControlTemplate TargetType="GridSplitter"><Grid Background="{StaticResource Panel}"><Border x:Name="Divider" Width="1" Background="{StaticResource Line}"/><Border x:Name="Grip" Width="3" Height="36" CornerRadius="2" Background="{StaticResource Muted}"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Divider" Property="Background" Value="{StaticResource Accent}"/><Setter TargetName="Grip" Property="Background" Value="{StaticResource Accent}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Grip" Property="Background" Value="{StaticResource Accent}"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="Divider" Property="Background" Value="{StaticResource Accent}"/><Setter TargetName="Grip" Property="Background" Value="{StaticResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></GridSplitter.Template>
      </GridSplitter>
      <Grid Grid.Column="2" Margin="24,22,24,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="저장 공간 한눈에 보기" x:Name="FolderTitle" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="FolderPathText" Text="드라이브나 폴더를 선택하고 분석을 시작하세요." Foreground="{StaticResource Muted}" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/><TextBlock x:Name="CacheInfoText" Text="분석 결과를 자동으로 저장합니다." FontSize="11" Foreground="{StaticResource Accent}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,0"><Button x:Name="UpButton" Content="↑" ToolTip="상위 폴더 (Alt+↑)" Click="Up_Click" IsEnabled="False" Margin="0,0,6,0"/><Button x:Name="ExplorerButton" Content="탐색기" Click="Explorer_Click" IsEnabled="False"/></StackPanel></Grid>
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,20,0,8">
          <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="선택 폴더 용량" Style="{StaticResource MutedText}" FontSize="11"/><TextBlock x:Name="SizeText" Text="—" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,7,0,0"/></StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="4,0,4,0"><StackPanel><TextBlock Text="포함된 파일" Style="{StaticResource MutedText}" FontSize="11"/><TextBlock x:Name="FilesText" Text="—" FontSize="25" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="8,0,0,0"><StackPanel><TextBlock Text="포함된 폴더" Style="{StaticResource MutedText}" FontSize="11"/><TextBlock x:Name="FoldersText" Text="—" FontSize="25" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel></Border>
        </UniformGrid>
        <TabControl x:Name="MainTabs" Grid.Row="2">
          <TabItem Header="용량 지도"><Grid><Grid.RowDefinitions><RowDefinition Height="3*" MinHeight="170"/><RowDefinition Height="38"/><RowDefinition Height="2*" MinHeight="120"/></Grid.RowDefinitions>
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="8"><Grid><local:TreemapView x:Name="Map" Selected="Map_Selected" Navigated="Map_Navigated"/><StackPanel x:Name="WelcomePanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="390"><TextBlock Text="▦" FontSize="48" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyTitle" Text="어디에 공간을 쓰고 있나요?" FontSize="20" FontWeight="SemiBold" Margin="0,16,0,10" TextAlignment="Center"/><TextBlock x:Name="EmptyDescription" Text="왼쪽 드라이브를 누르거나 위에서 폴더를 선택하세요.&#x0a;큰 파일과 폴더일수록 넓은 사각형으로 표시됩니다." Style="{StaticResource MutedText}" TextAlignment="Center"/></StackPanel></Grid></Border>
            <DockPanel Grid.Row="1" VerticalAlignment="Center"><TextBlock DockPanel.Dock="Right" Text="● 임시 / 캐시" Foreground="{StaticResource Temporary}" FontSize="11" Margin="12,0,0,0"/><TextBlock DockPanel.Dock="Right" Text="더블클릭: 폴더 열기" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock x:Name="MapCaption" Text="면적 = 파일 크기 · 1 KB = 1,024 B" FontSize="11" Foreground="{StaticResource Muted}"/></DockPanel>
            <DataGrid Grid.Row="2" x:Name="ChildrenGrid" IsReadOnly="True" MouseDoubleClick="ChildrenGrid_DoubleClick" KeyDown="ChildrenGrid_KeyDown" SelectionChanged="ChildrenGrid_SelectionChanged"><DataGrid.Columns>
              <DataGridTemplateColumn Header="이름" Width="*" SortMemberPath="Name"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Symbol}" Foreground="{StaticResource Accent}" Margin="0,0,9,0"/><TextBlock Text="{Binding Name}" ToolTip="{Binding FullPath}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="크기" Binding="{Binding SizeText}" SortMemberPath="Size" Width="100"/>
              <DataGridTemplateColumn Header="비율" Width="115" SortMemberPath="Percent"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid><ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="4" VerticalAlignment="Bottom" Margin="0,0,0,2" Foreground="#55B99F" Background="#2B394B" BorderThickness="0"/><TextBlock Text="{Binding PercentText}" FontSize="11" Margin="0,0,0,9"/></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="유형" Binding="{Binding KindText}" Width="110"/>
            </DataGrid.Columns></DataGrid>
          </Grid></TabItem>
          <TabItem Header="정리 후보" x:Name="CandidatesTab"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,12"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="전체 선택" x:Name="SelectAllButton" Padding="10,6" Click="SelectAll_Click" IsEnabled="False"/><Button Content="선택 해제" x:Name="ClearSelectionButton" Padding="10,6" Margin="6,0,0,0" Click="ClearSelection_Click" IsEnabled="False"/></StackPanel><TextBlock x:Name="CandidatesSummary" Text="오른쪽에서 조건을 입력하고 검색하세요." Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0"/></DockPanel>
            <DataGrid Grid.Row="1" x:Name="CandidatesGrid" IsReadOnly="False"><DataGrid.Columns>
              <DataGridTemplateColumn Header="선택" Width="50"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Node.Name}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="파일 이름" Binding="{Binding Node.Name}" Width="*" IsReadOnly="True"/>
              <DataGridTextColumn Header="크기" Binding="{Binding Node.SizeText}" SortMemberPath="Node.Size" Width="95" IsReadOnly="True"/>
              <DataGridTextColumn Header="폴더 경로" Binding="{Binding DirectoryPath}" Width="2*" IsReadOnly="True"/>
            </DataGrid.Columns></DataGrid>
          </Grid></TabItem>
        </TabControl>
      </Grid>
      <Border Grid.Column="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="20,24,20,18">
        <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
            <TextBlock Text="조건으로 정리하기" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="현재 선택한 폴더 안에서 찾습니다." Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,22"/>
            <TextBlock Text="파일 확장자" Margin="0,0,0,7"/><TextBox x:Name="ExtensionBox" AutomationProperties.Name="파일 확장자" ToolTip=".zip, .mp4, .log · 비워 두면 전체"/>
            <TextBlock Text="예: .zip, .mp4, .log · 비우면 전체" Style="{StaticResource MutedText}" FontSize="11" Margin="0,5,0,17"/>
            <DockPanel Margin="0,0,0,7"><ComboBox DockPanel.Dock="Right" x:Name="UnitBox" Width="75" SelectedIndex="2" AutomationProperties.Name="파일 크기 단위"><ComboBoxItem Content="B"/><ComboBoxItem Content="KB"/><ComboBoxItem Content="MB"/><ComboBoxItem Content="GB"/><ComboBoxItem Content="TB"/></ComboBox><TextBlock Text="파일 크기" VerticalAlignment="Center"/></DockPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox x:Name="MinBox" AutomationProperties.Name="최소 크기" ToolTip="최소 크기 (이상)"/><TextBlock Grid.Column="1" Text="~" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBox Grid.Column="2" x:Name="MaxBox" AutomationProperties.Name="최대 크기" ToolTip="최대 크기 (이하)"/></Grid>
            <TextBlock Text="최소 이상 ~ 최대 이하 · 비우면 제한 없음" Style="{StaticResource MutedText}" FontSize="11" Margin="0,5,0,17"/>
            <TextBlock Text="파일 이름에 포함" Margin="0,0,0,7"/><TextBox x:Name="NameBox" AutomationProperties.Name="파일 이름에 포함"/>
            <CheckBox x:Name="RecursiveBox" Content="하위 폴더까지 검색" IsChecked="True" Margin="0,18,0,18"/>
            <Button x:Name="FilterButton" Content="조건에 맞는 파일 찾기" Click="Filter_Click" IsEnabled="False"/>
            <TextBlock x:Name="FilterError" Foreground="#FFB29F" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <Border Background="#202C39" CornerRadius="8" Padding="13" Margin="0,14,0,18"><StackPanel><TextBlock Text="정리 전 확인" Foreground="{StaticResource Accent}" FontWeight="SemiBold" Margin="0,0,0,7"/><TextBlock Text="검색 결과에서 파일을 직접 선택하세요. 시스템·읽기 전용 파일과 연결 경로는 제외합니다." Style="{StaticResource MutedText}" FontSize="12"/></StackPanel></Border>
          </StackPanel></ScrollViewer>
          <StackPanel Grid.Row="1"><Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,18,0,0"><StackPanel><TextBlock Text="선택한 파일 크기" Style="{StaticResource MutedText}" FontSize="11"/><TextBlock x:Name="SelectedSizeText" Text="0 B" FontSize="30" FontWeight="SemiBold" Margin="0,6,0,3"/><TextBlock x:Name="SelectedCountText" Text="선택된 파일 없음" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,14"/><Button x:Name="DeleteButton" Content="선택 파일 검토…" Style="{StaticResource PrimaryButton}" Click="Delete_Click" IsEnabled="False"/><TextBlock Text="확인 후 Windows 휴지통으로 이동합니다.&#x0a;휴지통을 비우기 전에는 여유 공간이 늘지 않습니다." Style="{StaticResource MutedText}" FontSize="10" Margin="0,10,0,0"/></StackPanel></Border></StackPanel>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="2" Background="#151C28" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ProgressBar x:Name="BusyBar" Width="72" Height="4" Foreground="{StaticResource Accent}" Background="#2A3547" BorderThickness="0" Margin="0,0,12,0"/><TextBlock Grid.Column="1" x:Name="StatusText" Text="준비됨 · 분석할 드라이브 또는 폴더를 선택하세요." VerticalAlignment="Center" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/><Button Grid.Column="2" x:Name="IssuesButton" Content="제외 항목 0" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center" Click="Issues_Click" IsEnabled="False"/></Grid></Border>
  </Grid>
</Window>
